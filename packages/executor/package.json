{
  "name": "@beevibe/executor",
  "version": "0.0.1",
  "private": true,
  "description": "Beevibe executor — polls DB for assigned tasks and dispatches task sessions",
  "type": "module",
  "main": "./dist/main.js",
  "bin": {
    "beevibe-executor": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@beevibe/core": "workspace:*"
  }
}
